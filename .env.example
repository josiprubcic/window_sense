PORT=3000
SPRING_PROFILES_ACTIVE=local

# Local PostgreSQL 17 profile. The defaults match docker-compose.yml.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/windowsense
SPRING_DATASOURCE_USERNAME=windowsense
SPRING_DATASOURCE_PASSWORD=windowsense

# ThingsBoard HTTP Device API for the existing legacy/global physical device.
# Example: https://thingsboard.cloud or http://localhost:8080
THINGSBOARD_HOST=https://eu.thingsboard.cloud
THINGSBOARD_ACCESS_TOKEN=DEVICE_ACCESS_TOKEN
THINGSBOARD_SYNC_ENABLED=true

# ThingsBoard REST provisioning API for creating Assets, Devices and relations.
# Keep real values out of git. Do not reuse THINGSBOARD_ACCESS_TOKEN here.
THINGSBOARD_PROVISIONING_ENABLED=false
THINGSBOARD_PROVISIONING_AUTH_MODE=password
THINGSBOARD_USERNAME=tenant@example.com
THINGSBOARD_PASSWORD=your_thingsboard_password
THINGSBOARD_JWT_TOKEN=eyJhbGciOi...
THINGSBOARD_API_KEY=tb-api-key-placeholder

# Auth0/OIDC login.
OIDC_ENABLED=false
OIDC_ISSUER_URI=https://your-tenant.eu.auth0.com/
OIDC_CLIENT_ID=YOUR_CLIENT_ID
OIDC_CLIENT_SECRET=YOUR_CLIENT_SECRET
OIDC_SCOPES=openid,profile,email

# Logical device id used by the ESP32 when polling local backend commands.
WINDOWSENSE_DEVICE_ID=windowsense-esp32-01
