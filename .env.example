PORT=3000

# ThingsBoard HTTP Device API.
# Example: https://thingsboard.cloud or http://localhost:8080
THINGSBOARD_HOST=https://eu.thingsboard.cloud
THINGSBOARD_ACCESS_TOKEN=DEVICE_ACCESS_TOKEN
THINGSBOARD_SYNC_ENABLED=true

# Auth0/OIDC login.
OIDC_ENABLED=false
OIDC_ISSUER_URI=https://your-tenant.eu.auth0.com/
OIDC_CLIENT_ID=YOUR_CLIENT_ID
OIDC_CLIENT_SECRET=YOUR_CLIENT_SECRET
OIDC_SCOPES=openid,profile,email

# Logical device id used by the ESP32 when polling local backend commands.
WINDOWSENSE_DEVICE_ID=windowsense-esp32-01
